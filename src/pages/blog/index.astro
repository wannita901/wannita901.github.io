---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ComingSoon from '../../components/ComingSoon.astro';
import { getCollection } from 'astro:content';
import { readingTime } from '../../lib/reading-time';

const posts = (await getCollection('blog', (p) => !p.data.draft)).sort((a, b) => +b.data.date - +a.data.date);
const fmt = (d: Date) => d.toLocaleDateString('en-AU', { day: 'numeric', month: 'short', year: 'numeric' });
---
<BaseLayout title="Writing" description="Notes on LLM tooling for developers, research process, and what survives contact with production.">
  <header class="stack" style="gap: 10px;">
    <h1>Writing</h1>
    <p class="muted">Notes on LLM tooling for developers, research process, and what survives contact with production.</p>
  </header>
  {posts.length === 0 ? <ComingSoon /> : (
    <div class="stack" style="gap: 26px;">
      {posts.map((p, i) => (<>
        {i > 0 && <div class="rule"></div>}
        <article class="stack" style="gap: 6px;">
          <div class="row"><a href={`/blog/${p.id}/`} class="plain title">{p.data.title}</a><span class="mono" style="flex-shrink: 0;">{fmt(p.data.date)}</span></div>
          <p class="fg2" style="font-size: 16px;">{p.data.description}</p>
          <div class="meta"><span class="mono">{readingTime(p.body ?? '')}</span>{p.data.tags.map((t) => <span class="tag">{t}</span>)}</div>
        </article>
      </>))}
    </div>
  )}
</BaseLayout>
<style>
  .title { font-size: 21px; font-family: var(--serif); font-weight: 500; }
  .meta { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
</style>
