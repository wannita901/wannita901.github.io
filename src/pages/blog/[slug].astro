---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { readingTime } from '../../lib/reading-time';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', (p) => !p.data.draft)).sort((a, b) => +b.data.date - +a.data.date);
  return posts.map((post, i) => ({ params: { slug: post.id }, props: { post, prev: posts[i + 1], next: posts[i - 1] } }));
}
const { post, prev, next } = Astro.props;
const { Content } = await render(post);
const fmt = (d: Date) => d.toLocaleDateString('en-AU', { day: 'numeric', month: 'short', year: 'numeric' });
---
<BaseLayout title={post.data.title} description={post.data.description}>
  <header class="stack" style="gap: 14px;">
    <a href="/blog/" class="mono plain">← Writing</a>
    <h1>{post.data.title}</h1>
    <div class="meta"><span class="mono">{fmt(post.data.date)}</span><span class="mono">·</span><span class="mono">{readingTime(post.body ?? '')}</span>{post.data.tags.map((t) => <span class="tag">{t}</span>)}</div>
  </header>
  <article class="prose"><Content /></article>
  <div class="rule"></div>
  <nav class="row" style="font-size: 15px;">
    <span>{prev && <a href={`/blog/${prev.id}/`} class="plain">← {prev.data.title}</a>}</span>
    <span>{next && <a href={`/blog/${next.id}/`} class="plain">{next.data.title} →</a>}</span>
  </nav>
</BaseLayout>
<style>
  .meta { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
</style>
