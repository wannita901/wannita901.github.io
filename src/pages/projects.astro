---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import ProjectRow from '../components/ProjectRow.astro';
import { getCollection } from 'astro:content';

const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const groups: [string, string][] = [['research', 'Research tools'], ['side', 'Side projects'], ['hackathon', 'Hackathons & student work']];
---
<BaseLayout title="Projects" description="Research tools, side projects and hackathon entries by Wannita Takerngsaksiri.">
  <header class="stack" style="gap: 10px;">
    <h1>Projects</h1>
    <p class="muted">Research tools I built or co-built, side projects, and hackathon entries. Most are on <a href="https://github.com/wannita901">GitHub</a>; models and datasets on <a href="https://huggingface.co/Wannita">Hugging Face</a>.</p>
  </header>
  {groups.map(([key, title]) => {
    const items = all.filter((p) => p.data.group === key);
    return items.length > 0 && (
      <Section title={title}><div class="stack" style="gap: 10px;">{items.map((p) => <ProjectRow project={p} />)}</div></Section>
    );
  })}
</BaseLayout>
