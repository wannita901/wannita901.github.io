---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import EventRow from '../components/EventRow.astro';
import { getCollection } from 'astro:content';
import { site } from '../site';
import { cv } from '../data/cv';

const events = (await getCollection('events')).sort((a, b) => +b.data.date - +a.data.date);
---
<BaseLayout title="About" description="About Wannita Takerngsaksiri: Research Fellow at Deakin A2I2, PhD Monash, AI for Software Engineering.">
  <header class="hero">
    <img src="/avatar.svg" alt="" width="120" height="120" class="avatar" />
    <div class="prose" style="font-size: 17px; line-height: 1.6;">
      <h1 style="color: var(--fg);">About</h1>
      <!-- Edit the bio here. Plain HTML paragraphs. -->
      <p>I am a Research Fellow at Deakin University's Applied Artificial Intelligence Initiative (A2I2) in Melbourne, working on AI for Software Engineering. I care about tools that developers actually adopt: code completion that respects syntax, test generation that runs, agents that keep a human in the loop.</p>
      <p>I did my PhD at Monash University with <a href="https://chakkrit.com">Chakkrit Tantithamthavorn</a>, building PyCoder and PyTester and working on HULA, a human-in-the-loop coding agent deployed inside Atlassian Jira. Before research I was a data scientist at Siam Commercial Bank and CP Group in Bangkok, and a Data Scientist Intern at Atlassian. I studied engineering at Chulalongkorn University.</p>
      <p>Outside work: dogs, hackathons, and the Melbourne AI Engineering Network meetup.</p>
    </div>
  </header>

  <div id="events"><Section title="Events">
    <div class="stack" style="gap: 8px;">{events.map((e) => <EventRow event={e} />)}</div>
  </Section></div>

  <div id="cv"><Section title="CV" more={{ label: 'Download PDF', href: '/cv.pdf' }}>
    <div class="stack" style="gap: 8px;">
      {cv.map((r) => (<div class="cvrow"><span class="mono d">{r.when}</span><span><b>{r.role}</b>, {r.where}</span></div>))}
    </div>
  </Section></div>

  <Section title="Supervision">
    <p class="fg2">Open to Masters by Research and PhD students at Deakin in AI for Software Engineering: LLM coding tools, evaluation of foundation-model applications, human-AI collaboration in development. Email a one-page idea.</p>
  </Section>

  <Section title="Contact">
    <div class="links" style="font-size: 16px;">{site.socials.map((s) => <a href={s.href}>{s.label}</a>)}</div>
  </Section>
</BaseLayout>
<style>
  .hero { display: flex; gap: 32px; align-items: flex-start; }
  .avatar { flex-shrink: 0; border-radius: 8px; image-rendering: pixelated; }
  .cvrow { display: flex; gap: 20px; font-size: 16px; }
  .d { width: 110px; flex-shrink: 0; padding-top: 4px; }
  b { font-weight: 500; }
  @media (max-width: 560px) { .hero { flex-direction: column; gap: 16px; } .avatar { width: 88px; height: 88px; } .cvrow { flex-direction: column; gap: 0; } }
</style>
