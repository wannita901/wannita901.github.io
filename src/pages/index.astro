---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import ProjectLine from '../components/ProjectLine.astro';
import PubLine from '../components/PubLine.astro';
import EventRow from '../components/EventRow.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { getCollection } from 'astro:content';
import { loadPublications } from '../lib/bib';
import { site } from '../site';
import { icons } from '../components/icons';

const posts = (await getCollection('blog', (p) => !p.data.draft)).sort((a, b) => +b.data.date - +a.data.date).slice(0, 3);
const projects = (await getCollection('projects', (p) => p.data.home)).sort((a, b) => a.data.order - b.data.order);
const pubs = loadPublications().filter((p) => p.selected);
const events = (await getCollection('events')).sort((a, b) => +b.data.date - +a.data.date);
const month = (d: Date) => d.toLocaleDateString('en-AU', { month: 'short', year: 'numeric' });
---
<BaseLayout>
  <header class="hero">
    <img src="/avatar.svg" alt="" width="128" height="128" class="avatar" />
    <div class="stack" style="gap: 16px;">
      <div class="stack" style="gap: 8px;">
        <h1 style="font-size: 44px;">{site.name}</h1>
        <div class="role">{site.role}</div>
      </div>
      <p class="fg2" style="font-size: 19px; line-height: 1.55;">{site.bio}</p>
      <p class="prev">previously, data scientist intern at <a href={site.previously.intern.href} class="chip"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons[site.previously.intern.icon]} />{site.previously.intern.label}</a>, and data scientist at {site.previously.roles.map((r, i) => (<>{i > 0 && ' and '}<a href={r.href} class="chip"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons[r.icon]} />{r.label}</a></>))}.</p>
      <p class="muted" style="font-size: 16px;">{site.outside}</p>
    </div>
  </header>

  {posts.length > 0 && (
    <Section title="Writing" more={{ label: 'All posts', href: '/blog/' }}>
      <div class="stack" style="gap: 8px;">
        {posts.map((p) => (
          <div class="line"><span class="arrow">→</span><a href={`/blog/${p.id}/`} class="plain one post">{p.data.title}</a><span class="mono date">{month(p.data.date)}</span></div>
        ))}
      </div>
    </Section>
  )}

  <Section title="Projects" more={{ label: 'All projects', href: '/projects/' }}>
    <div class="stack" style="gap: 8px;">{projects.map((p) => <ProjectLine project={p} />)}</div>
  </Section>

  <Section title="Publications" more={{ label: 'All papers', href: '/publications/' }}>
    <div class="stack" style="gap: 8px;">{pubs.map((p) => <PubLine pub={p} />)}</div>
  </Section>

  <Section title="Community">
    <div class="stack" style="gap: 8px;">{events.map((e) => <EventRow event={e} />)}</div>
  </Section>

  <Section title="Supervision">
    <p class="fg2">{site.supervision}</p>
  </Section>

  <Section title="Contact">
    <div class="stack" style="gap: 12px;">
      <p class="fg2">{site.openTo} Fastest is email: <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
      <SocialLinks />
    </div>
  </Section>
</BaseLayout>
<style>
  .hero { display: flex; gap: 32px; align-items: flex-start; }
  .avatar { flex-shrink: 0; border-radius: 8px; image-rendering: pixelated; }
  .role { font-family: var(--mono); font-size: 14px; color: var(--accent); letter-spacing: .02em; }
  .prev { font-size: 16px; color: var(--muted); line-height: 1.9; }
  .chip { display: inline-flex; align-items: center; gap: 6px; height: 26px; padding: 0 8px; margin: 0 1px; border: 1px solid var(--rule); border-radius: 4px; font-family: var(--mono); font-size: 12px; color: var(--fg-2); text-decoration: none; vertical-align: middle; }
  .chip:hover { border-color: var(--accent); color: var(--accent); }
  .chip svg { width: 16px; height: 16px; fill: currentColor; }
  .arrow { color: var(--accent); flex-shrink: 0; }
  .post { font-family: var(--serif); font-size: 19px; }
  .date { flex-shrink: 0; }
  @media (max-width: 560px) { .hero { flex-direction: column; gap: 16px; } .hero h1 { font-size: 32px !important; } .avatar { width: 96px; height: 96px; } .post { order: 3; } .date { margin-left: auto; } }
</style>
