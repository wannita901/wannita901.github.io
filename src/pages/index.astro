---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import ProjectLine from '../components/ProjectLine.astro';
import PubLine from '../components/PubLine.astro';
import EventRow from '../components/EventRow.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { getCollection } from 'astro:content';
import { loadPublications } from '../lib/bib';
import { site } from '../site';
import { icons } from '../components/icons';

const posts = (await getCollection('blog', (p) => !p.data.draft)).sort((a, b) => +b.data.date - +a.data.date).slice(0, 3);
const projects = (await getCollection('projects', (p) => p.data.home)).sort((a, b) => a.data.order - b.data.order);
const pubs = loadPublications().filter((p) => p.selected);
const events = (await getCollection('events')).sort((a, b) => +b.data.date - +a.data.date);
const month = (d: Date) => d.toLocaleDateString('en-AU', { month: 'short', year: 'numeric' });
---
<BaseLayout>
  <header class="hero">
    <img src="/avatar.svg" alt="" width="128" height="128" class="avatar" />
    <div class="stack" style="gap: 16px;">
      <div class="stack" style="gap: 8px;">
        <h1 style="font-size: 44px;">{site.name}</h1>
        <div class="role">{site.role}
          {site.socials.filter((s) => s.label === 'Email').map((s) => (
            <a href={s.href} class="rolelink" aria-label={s.label} title={s.label}><svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons[s.icon]} /></a>
          ))}
        </div>
      </div>
      <p class="fg2" style="font-size: 19px; line-height: 1.55;">{site.bio}</p>
      <dl class="meta">
        <dt class="mono">previously</dt>
        <dd>data scientist intern at <a href={site.previously.intern.href} class="tl"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons[site.previously.intern.icon]} />{site.previously.intern.label}</a> · data scientist at {site.previously.roles.map((r, i) => (<>{i > 0 && ' and '}<a href={r.href} class="tl"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons[r.icon]} />{r.label}</a></>))}</dd>
        <dt class="mono">outside work</dt>
        <dd class="oneline">{site.outside.map((o) => (<span class="ow"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons[o.icon]} />{o.label}</span>))}</dd>
      </dl>
    </div>
  </header>

  {posts.length > 0 && (
    <Section title="Writing" more={{ label: 'All posts', href: '/blog/' }}>
      <div class="stack" style="gap: 8px;">
        {posts.map((p) => (
          <div class="line"><span class="arrow">→</span><a href={`/blog/${p.id}/`} class="plain one post">{p.data.title}</a><span class="mono date">{month(p.data.date)}</span></div>
        ))}
      </div>
    </Section>
  )}

  <Section title="Projects" more={{ label: 'All projects', href: '/projects/' }}>
    <div class="stack" style="gap: 8px;">{projects.map((p) => <ProjectLine project={p} />)}</div>
  </Section>

  <Section title="Publications" more={{ label: 'All papers', href: '/publications/' }}>
    <div class="stack" style="gap: 8px;">{pubs.map((p) => <PubLine pub={p} />)}</div>
  </Section>

  <Section title="Community">
    <div class="stack" style="gap: 8px;">{events.map((e) => <EventRow event={e} />)}</div>
  </Section>

  <Section title="Supervision">
    <p class="fg2">{site.supervision}</p>
  </Section>

  <Section title="Contact">
    <div class="stack" style="gap: 12px;">
      <p class="fg2">{site.openTo} Fastest is email: <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
      <SocialLinks />
    </div>
  </Section>
</BaseLayout>
<style>
  .hero { display: flex; gap: 32px; align-items: flex-start; }
  .avatar { flex-shrink: 0; border-radius: 8px; image-rendering: pixelated; }
  .role { font-family: var(--mono); font-size: 14px; color: var(--accent); letter-spacing: .02em; display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .rolelink { display: inline-flex; padding: 4px; margin: -4px 0; color: var(--accent); }
  .rolelink:first-of-type { margin-left: 4px; }
  .rolelink svg { width: 16px; height: 16px; fill: currentColor; }
  .rolelink:hover { color: var(--fg); }
  .meta { margin: 0; display: grid; grid-template-columns: 96px 1fr; gap: 6px 14px; font-size: 16px; color: var(--muted); line-height: 1.7; align-items: baseline; }
  .meta dt { padding-top: 3px; }
  .meta dd { margin: 0; }
  .tl { display: inline-flex; align-items: center; gap: 5px; color: var(--muted); text-decoration: none; vertical-align: baseline; }
  .tl:hover { color: var(--accent); }
  .tl svg { width: 14px; height: 14px; fill: currentColor; }
  .ow { display: inline-flex; align-items: center; gap: 6px; margin-right: 12px; white-space: nowrap; }
  .ow:last-child { margin-right: 0; }
  dd.oneline { white-space: nowrap; }
  .ow svg { width: 15px; height: 15px; }
  @media (max-width: 560px) { .meta { grid-template-columns: 1fr; gap: 2px; } .meta dd { margin-bottom: 8px; } dd.oneline { white-space: normal; } }
  .arrow { color: var(--accent); flex-shrink: 0; }
  .post { font-family: var(--serif); font-size: 19px; }
  .date { flex-shrink: 0; }
  @media (max-width: 560px) { .hero { flex-direction: column; gap: 16px; } .hero h1 { font-size: 32px !important; } .avatar { width: 96px; height: 96px; } .post { order: 3; } .date { margin-left: auto; } }
</style>
