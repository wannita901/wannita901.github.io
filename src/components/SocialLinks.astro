---
import { site } from '../site';
import { icons } from './icons';
interface Props { size?: number; }
const { size = 16 } = Astro.props;
---
<div class="socials">
  {site.socials.map((s) => (
    <a href={s.href} class="plain">
      <svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" set:html={icons[s.icon]} />
      <span>{s.label}</span>
    </a>
  ))}
</div>
<style>
  .socials { display: flex; gap: 8px 20px; flex-wrap: wrap; font-size: 15px; }
  a { display: inline-flex; align-items: center; gap: 7px; }
  svg { fill: currentColor; color: var(--fg-2); flex-shrink: 0; }
  a:hover svg { color: var(--accent); }
</style>
