---
import type { Pub } from '../lib/bib';
interface Props { pub: Pub; }
const { pub } = Astro.props;
const me = /Takerngsaksiri/;
---
<div class="pub">
  <span class="t">{pub.title}</span>
  <span class="a">
    {pub.authors.map((a, i) => (<>{i > 0 && ', '}{me.test(a) ? <b>{a}</b> : a}</>))}
    {pub.venue && <> · {pub.venue}</>}
  </span>
  {pub.links.length > 0 && <div class="btns">{pub.links.map((l) => <a href={l.href} class="btn">{l.label}</a>)}</div>}
</div>
<style>
  .pub { display: flex; flex-direction: column; gap: 4px; }
  .t { font-size: 17px; }
  .a { font-size: 15px; color: var(--muted); }
  .a b { font-weight: 500; color: var(--fg-2); }
  .btns { display: flex; gap: 6px; flex-wrap: wrap; padding-top: 4px; }
</style>
