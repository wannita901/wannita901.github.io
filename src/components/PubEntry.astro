---
import type { Pub } from '../lib/bib';
interface Props { pub: Pub; }
const { pub } = Astro.props;
const me = /Takerngsaksiri/;
const MAX = 7;
const etAl = pub.authors.length > MAX;
const shown = etAl ? pub.authors.slice(0, 6) : pub.authors;
const hiddenMe = etAl ? pub.authors.slice(6).find((a) => me.test(a)) : undefined;
const pick = (l: string) => pub.links.find((x) => x.label === l)?.href;
const href = pick('arxiv') ?? pick('doi') ?? pick('pdf');
---
<div class="pub" id={pub.key}>
  {href ? <a href={href} class="t plain">{pub.title}</a> : <span class="t">{pub.title}</span>}
  <span class="a">
    {shown.map((a, i) => (<>{i > 0 && ', '}{me.test(a) ? <b>{a}</b> : a}</>))}{hiddenMe && <>, …, <b>{hiddenMe}</b></>}{etAl && <> et al.</>}
    {pub.venue && <> · {pub.venue}</>}
  </span>
  {pub.links.length > 0 && <div class="btns">{pub.links.map((l) => <a href={l.href} class="btn">{l.label}</a>)}</div>}
</div>
<style>
  .pub { display: flex; flex-direction: column; gap: 4px; scroll-margin-top: 24px; }
  .t { font-size: 17px; }
  .a { font-size: 15px; color: var(--muted); }
  .a b { font-weight: 500; color: var(--fg-2); }
  .btns { display: flex; gap: 6px; flex-wrap: wrap; padding-top: 4px; }
</style>
