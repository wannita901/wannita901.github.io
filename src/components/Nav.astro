---
import { site } from '../site';
import { getCollection } from 'astro:content';
const path = Astro.url.pathname;
const hasPosts = (await getCollection('blog', (p) => !p.data.draft)).length > 0;
const items = site.nav.filter((n) => hasPosts || n.href !== '/blog/');
---
<nav class="nav">
  <a href="/" class="plain brand" aria-current={path === '/' ? 'page' : undefined}>{site.shortName}</a>
  <div class="items">
    {items.map((n) => (
      <a href={n.href} class="plain" aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>
    ))}
    <button id="theme" type="button" aria-label="Toggle dark mode" title="Toggle dark mode">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
    </button>
  </div>
</nav>
<script is:inline>
  document.getElementById('theme').addEventListener('click', function () {
    var root = document.documentElement;
    var next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    try { localStorage.setItem('theme', next); } catch (e) {}
  });
</script>
<style>
  .nav { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px 24px; }
  .brand { font-family: var(--serif); font-size: 20px; font-weight: 500; }
  .items { display: flex; gap: 24px; font-size: 15px; align-items: center; }
  .items a { padding: 3px 0; }
  .items a[aria-current="page"], .brand[aria-current="page"] { color: var(--accent); }
  button { background: none; border: 0; padding: 4px; margin: -4px; color: var(--muted); cursor: pointer; display: inline-flex; }
  button:hover { color: var(--accent); }
  @media (max-width: 480px) { .items { gap: 16px; font-size: 14px; } }
</style>
