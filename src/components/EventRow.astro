---
import type { CollectionEntry } from 'astro:content';
interface Props { event: CollectionEntry<'events'>; }
const { event: e } = Astro.props;
const { position, track, venue, link } = e.data;
---
<div class="line">
  <b class="pos">{link ? <a href={link} class="plain">{position}</a> : position}</b>
  {track && <span class="one fg2">{track}</span>}
  <span class="dots"></span>
  <span class="mono venue">{venue}</span>
</div>
<style>
  .pos { font-weight: 500; flex-shrink: 0; }
  .venue { flex-shrink: 0; }
  @media (max-width: 560px) { .one { order: 3; padding-left: 0; color: var(--muted); font-size: 15px; } .venue { order: 4; } .pos a { display: inline-block; padding: 2px 0; } }
</style>
