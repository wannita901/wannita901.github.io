---
import type { CollectionEntry } from 'astro:content';
interface Props { event: CollectionEntry<'events'>; }
const { event: e } = Astro.props;
const d = e.data.date.toISOString().slice(0, 7);
---
<div class="ev">
  <span class="mono d">{d}</span>
  <span>
    {e.data.link ? <a href={e.data.link}>{e.data.title}</a> : e.data.title}
  </span>
</div>
<style>
  .ev { display: flex; gap: 20px; font-size: 16px; }
  .d { width: 84px; flex-shrink: 0; padding-top: 4px; }
</style>
